<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #A8D86E;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.trashslammers.controller.EnclosureController">

   <!-- Title -->
   <Label layoutX="335.0" layoutY="15.0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #31572C;" text="TRASH SLAMMERS" />

   <Label layoutX="377.0" layoutY="46.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #527A34;" text="KOALA HABITAT" />

   <!-- Trees outside enclosure -->
   <Label layoutX="126.0" layoutY="55.0" style="-fx-font-size: 36px;" text="🌳" />
   <Label layoutX="656.0" layoutY="55.0" style="-fx-font-size: 36px;" text="🌳" />

   <!-- Main enclosure -->
   <AnchorPane layoutX="232.0" layoutY="90.0" prefHeight="330.0" prefWidth="330.0" style="-fx-background-color: #7DB957;
                         -fx-border-color: #704214;
                         -fx-border-width: 8px;
                         -fx-border-radius: 5px;
                         -fx-background-radius: 5px;">


      <!-- Tree -->
      <Label layoutX="20.0" layoutY="45.0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #31572C;" text="🌳" />

      <!-- Rock -->
      <Label layoutX="35.0" layoutY="130.0" style="-fx-font-size: 36px; -fx-text-fill: #555555;" text="🪨" />

      <!-- Pond -->
      <AnchorPane layoutX="205.0" layoutY="155.0" prefHeight="55.0" prefWidth="90.0" style="-fx-background-color: #6CB6D9;
                             -fx-background-radius: 30px;">
         <Label layoutX="38.0" layoutY="20.0" style="-fx-font-size: 36px; -fx-text-fill: #24566D;" text="🌊" />
      </AnchorPane>

      <!-- Koala 1 -->
      <VBox fx:id="koala1" alignment="CENTER" layoutX="85.0" layoutY="65.0" onMouseClicked="#handleKoala1Click" prefHeight="70.0" prefWidth="80.0" style="-fx-cursor: hand;">
         <Label prefHeight="45.0" prefWidth="45.0" style="-fx-font-size: 36px; -fx-font-weight: bold;" text="🐨">
            <font>
               <Font size="40.0" />
            </font>
         </Label>
      </VBox>

      <!-- Koala 2 -->
      <VBox fx:id="koala2" alignment="CENTER" layoutX="180.0" layoutY="90.0" onMouseClicked="#handleKoala2Click" prefHeight="70.0" prefWidth="80.0" style="-fx-cursor: hand;">
         <Label style="-fx-font-size: 36px; -fx-font-weight: bold;" text="🐨" />

      </VBox>



   </AnchorPane>

   <!-- Gate -->
   <Label layoutX="368.0" layoutY="427.0" style="-fx-background-color: #8B5A2B;
                    -fx-text-fill: white;
                    -fx-padding: 8px 14px;
                    -fx-font-weight: bold;" text="GATE" />

   <!-- Information sign -->
   <VBox layoutX="267.0" layoutY="461.0" prefHeight="80.0" prefWidth="270.0" spacing="4.0" style="-fx-background-color: #E5C07B;
                -fx-border-color: #704214;
                -fx-border-width: 3px;
                -fx-padding: 8px;">
      <Label style="-fx-font-size: 14px;
                     -fx-font-weight: bold;
                     -fx-text-fill: #31572C;" text="CURRENT RESIDENTS" />
      <HBox spacing="6.0">
         <Label onMouseClicked="#handleKoala1Click" style="-fx-text-fill: #1B4332; -fx-underline: true; -fx-cursor: hand; -fx-font-weight: bold;" text="Kai" />
         <Label text="— Australian Koala ★★★☆☆" />
      </HBox>
      <HBox spacing="6.0">
         <Label onMouseClicked="#handleKoala2Click" style="-fx-text-fill: #1B4332; -fx-underline: true; -fx-cursor: hand; -fx-font-weight: bold;" text="Willow" />
         <Label text="— Australian Koala ★★★★☆" />
      </HBox>
   </VBox>


   <!-- Back button -->
   <Button layoutX="318.0" layoutY="551.0" mnemonicParsing="false" onAction="#goBack" prefHeight="30.0" prefWidth="170.0" style="-fx-background-color: #527A34;
                     -fx-text-fill: white;
                     -fx-font-weight: bold;
                     -fx-background-radius: 10px;" text="BACK TO MENU" />

</AnchorPane>