<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.trashslammers.controller.LevelSelectController">
    <children>

        <!-- Main blue play area -->
        <AnchorPane prefHeight="505.0" prefWidth="800.0" style="-fx-background-color: #a8dcf0;">
            <children>

                <!-- Title -->
                <Text layoutX="248.0" layoutY="70.0" strokeType="OUTSIDE" strokeWidth="0.0" text="SELECT LEVEL">
                    <font>
                        <Font name="Segoe UI Semibold" size="40.0" />
                    </font>
                </Text>

                <!-- Row 1 -->
                <Button layoutX="60.0" layoutY="140.0" mnemonicParsing="false" onAction="#goToLevel1" prefHeight="90.0" prefWidth="200.0" style="-fx-font-size: 20; -fx-background-radius: 20; -fx-font-weight: bold; -fx-text-fill: black; -fx-background-color: linear-gradient(to bottom, #ffd76b, #f5a623); -fx-border-color: #ffd76b; -fx-border-radius: 20; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 4, 0, 0, 2);" text="LEVEL 1" />

                <Button layoutX="300.0" layoutY="140.0" mnemonicParsing="false" onAction="#goToLevel2" prefHeight="90.0" prefWidth="200.0" style="-fx-font-size: 20; -fx-background-radius: 20; -fx-font-weight: bold; -fx-text-fill: black; -fx-background-color: linear-gradient(to bottom, #ffd76b, #f5a623); -fx-border-color: #ffd76b; -fx-border-radius: 20; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 4, 0, 0, 2);" text="LEVEL 2" />

                <Button layoutX="540.0" layoutY="140.0" mnemonicParsing="false" onAction="#goToLevel3" prefHeight="90.0" prefWidth="200.0" style="-fx-font-size: 20; -fx-background-radius: 20; -fx-font-weight: bold; -fx-text-fill: black; -fx-background-color: linear-gradient(to bottom, #ffd76b, #f5a623); -fx-border-color: #ffd76b; -fx-border-radius: 20; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 4, 0, 0, 2);" text="LEVEL 3" />

                <!-- Row 2 (locked placeholders) -->
                <Button disable="true" layoutX="60.0" layoutY="260.0" mnemonicParsing="false" prefHeight="90.0" prefWidth="200.0" style="-fx-font-size: 18; -fx-background-radius: 20; -fx-font-weight: bold; -fx-text-fill: #666666; -fx-background-color: #c9c9c9; -fx-border-color: #a0a0a0; -fx-border-radius: 20; -fx-border-width: 2;" text="🔒 LEVEL 4" />

                <Button disable="true" layoutX="300.0" layoutY="260.0" mnemonicParsing="false" prefHeight="90.0" prefWidth="200.0" style="-fx-font-size: 18; -fx-background-radius: 20; -fx-font-weight: bold; -fx-text-fill: #666666; -fx-background-color: #c9c9c9; -fx-border-color: #a0a0a0; -fx-border-radius: 20; -fx-border-width: 2;" text="🔒 LEVEL 5" />

                <Button disable="true" layoutX="540.0" layoutY="260.0" mnemonicParsing="false" prefHeight="90.0" prefWidth="200.0" style="-fx-font-size: 18; -fx-background-radius: 20; -fx-font-weight: bold; -fx-text-fill: #666666; -fx-background-color: #c9c9c9; -fx-border-color: #a0a0a0; -fx-border-radius: 20; -fx-border-width: 2;" text="🔒 LEVEL 6" />

                <!-- Row 3 (locked placeholders) -->
                <Button disable="true" layoutX="60.0" layoutY="380.0" mnemonicParsing="false" prefHeight="90.0" prefWidth="200.0" style="-fx-font-size: 18; -fx-background-radius: 20; -fx-font-weight: bold; -fx-text-fill: #666666; -fx-background-color: #c9c9c9; -fx-border-color: #a0a0a0; -fx-border-radius: 20; -fx-border-width: 2;" text="🔒 LEVEL 7" />

                <Button disable="true" layoutX="300.0" layoutY="380.0" mnemonicParsing="false" prefHeight="90.0" prefWidth="200.0" style="-fx-font-size: 18; -fx-background-radius: 20; -fx-font-weight: bold; -fx-text-fill: #666666; -fx-background-color: #c9c9c9; -fx-border-color: #a0a0a0; -fx-border-radius: 20; -fx-border-width: 2;" text="🔒 LEVEL 8" />

                <Button disable="true" layoutX="540.0" layoutY="380.0" mnemonicParsing="false" prefHeight="90.0" prefWidth="200.0" style="-fx-font-size: 18; -fx-background-radius: 20; -fx-font-weight: bold; -fx-text-fill: #666666; -fx-background-color: #c9c9c9; -fx-border-color: #a0a0a0; -fx-border-radius: 20; -fx-border-width: 2;" text="🔒 LEVEL 9" />

            </children>
        </AnchorPane>

        <!-- Bottom green bar -->
        <AnchorPane prefHeight="95.0" prefWidth="800.0" style="-fx-background-color: #aed581;">
            <children>
                <Button layoutX="267.0" layoutY="20.0" mnemonicParsing="false" onAction="#goBack" prefHeight="56.0" prefWidth="265.0" style="-fx-font-size: 18; -fx-background-radius: 30; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #527A34; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 4, 0, 0, 2);" text="BACK TO MENU" />
            </children>
        </AnchorPane>

    </children>
</VBox>
