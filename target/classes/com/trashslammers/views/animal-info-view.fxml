<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #E5C07B;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.trashslammers.controller.AnimalInfoController">

    <VBox alignment="TOP_CENTER" layoutX="30.0" layoutY="40.0" prefHeight="420.0" prefWidth="340.0" spacing="16.0" style="-fx-background-color: white;
                  -fx-border-color: #704214;
                  -fx-border-width: 4px;
                  -fx-padding: 20px;
                  -fx-background-radius: 10px;
                  -fx-border-radius: 10px;">

        <Label fx:id="emojiLabel" style="-fx-font-size: 60px;" text="🐨" />

        <Label fx:id="nameLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #31572C;" text="Name" />

        <Label fx:id="speciesLabel" style="-fx-font-size: 16px; -fx-text-fill: #527A34;" text="Species" />

        <Label fx:id="ratingLabel" style="-fx-font-size: 18px;" text="★★★☆☆" />

        <Label fx:id="descriptionLabel" style="-fx-font-size: 13px; -fx-text-fill: #333333;" text="Description" wrapText="true" />

        <Button mnemonicParsing="false" onAction="#goBack" prefHeight="30.0" prefWidth="170.0" style="-fx-background-color: #527A34;
                        -fx-text-fill: white;
                        -fx-font-weight: bold;
                        -fx-background-radius: 10px;" text="BACK TO ENCLOSURE" />

    </VBox>

</AnchorPane>