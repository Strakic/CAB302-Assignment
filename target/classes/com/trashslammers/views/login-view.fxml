<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.trashslammers.controller.LoginController">
   <children>
      <AnchorPane prefHeight="513.0" prefWidth="800.0" style="-fx-background-color: #a8dcf0;">
         <children>
            <Text layoutX="156.0" layoutY="132.0" strokeType="OUTSIDE" strokeWidth="0.0" text="TRASH SLAMMERS">
               <font>
                  <Font name="PIXY" size="60.0" />
               </font>
            </Text>
             <PasswordField fx:id="passwordField" layoutX="310.0" layoutY="284.0" prefHeight="38.0" prefWidth="186.0" promptText="Enter password">
               <font>
                  <Font name="PIXY" size="20.0" />
               </font></PasswordField>
         
                                  <Label layoutX="354.0" layoutY="260.0" text="Password:">
               <font>
                  <Font name="PIXY" size="20.0" />
               </font></Label>
             <TextField fx:id="usernameField" layoutX="310.0" layoutY="220.0" prefHeight="37.0" prefWidth="186.0" promptText="ENTER USERNAME">
               <font>
                  <Font name="PIXY" size="20.0" />
               </font></TextField>
         
                                  <Label layoutX="354.0" layoutY="196.0" text="Username:">
               <font>
                  <Font name="PIXY" size="20.0" />
               </font></Label>
         
                <Button fx:id="loginButton" layoutX="358.0" layoutY="380.0" onAction="#logIn" text="Submit">
               <font>
                  <Font name="PIXY" size="20.0" />
               </font></Button>
            <Button layoutX="14.0" layoutY="14.0" mnemonicParsing="false" text="BACK">
               <font>
                  <Font name="PIXY" size="20.0" />
               </font>
            </Button>
            <Button fx:id="loginButton1" layoutX="353.0" layoutY="331.0" onAction="#logIn" text="SIGN UP">
               <font>
                  <Font name="PIXY" size="20.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>
      <AnchorPane prefHeight="95.0" prefWidth="600.0" style="-fx-background-color: #aed581;" />
   </children>
</VBox>
