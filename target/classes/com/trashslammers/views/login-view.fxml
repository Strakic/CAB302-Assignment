<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"> fx:controller="com.trashslammers.controller.LoginController">
   <children>
      <TextField fx:id="emailField" layoutX="228.0" layoutY="163.0"
                 prefHeight="25.0" prefWidth="144.0" promptText="Email Address">
         <font><Font name="JetBrains Mono ExtraBold" size="12.0"/></font>
      </TextField>

      <PasswordField fx:id="passwordField" layoutX="228.0" layoutY="200.0"
                     prefHeight="25.0" prefWidth="144.0" promptText="Password">
         <font><Font name="JetBrains Mono ExtraBold" size="12.0"/></font>
      </PasswordField>
      <Label layoutX="225.0" layoutY="33.0" text="Login">
         <font>
            <Font name="JetBrains Mono ExtraBold" size="48.0" />
         </font>
      </Label>
      <Button layoutX="274.0" layoutY="336.0" mnemonicParsing="false"
              text="Login" onAction="#onLoginClicked" />
      <Label fx:id="Status" layoutX="279.0" layoutY="244.0" text="Status" textAlignment="CENTER" textFill="RED">
         <font>
            <Font name="JetBrains Mono ExtraBold" size="12.0" />
         </font></Label>
   </children>
</AnchorPane>
