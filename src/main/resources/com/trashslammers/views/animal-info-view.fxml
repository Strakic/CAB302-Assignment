<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0"
      style="-fx-background-color: #E5C07B;"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.trashslammers.controller.AnimalInfoController">
    <children>

        <VBox alignment="TOP_CENTER" spacing="16.0" maxWidth="420.0" maxHeight="500.0"
              style="-fx-background-color: white; -fx-border-color: #704214; -fx-border-width: 4px; -fx-background-radius: 10px; -fx-border-radius: 10px;">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <children>

                <Label fx:id="emojiLabel" style="-fx-font-size: 60px;" text="🐨" />

                <Label fx:id="nameLabel" styleClass="title-label" text="Name" />

                <Label fx:id="speciesLabel" styleClass="subtitle-label" text="Species" />

                <Label fx:id="ratingLabel" style="-fx-font-size: 22px;" text="★★★☆☆" />

                <Label fx:id="descriptionLabel" styleClass="body-label" text="Description"
                       wrapText="true" maxWidth="340.0" />

                <Button mnemonicParsing="false" onAction="#goBack" text="BACK TO ENCLOSURE" />

            </children>
        </VBox>

    </children>
</VBox>