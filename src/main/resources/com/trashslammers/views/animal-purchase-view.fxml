<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="480.0" prefWidth="420.0" style="-fx-background-color: #E5C07B;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.trashslammers.controller.AnimalPurchaseController">
   <children>
      <VBox alignment="TOP_CENTER" layoutX="30.0" layoutY="25.0" prefHeight="430.0" prefWidth="360.0" spacing="14.0" style="-fx-background-color: white; -fx-border-color: #704214; -fx-border-width: 4px; -fx-padding: 16px; -fx-background-radius: 10px; -fx-border-radius: 10px;">
         <children>
            <Label fx:id="nameLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #31572C;" text="Name" />
            <Label fx:id="speciesLabel" style="-fx-font-size: 13px; -fx-font-style: italic; -fx-text-fill: #527A34;" text="Species" />
            <Label fx:id="rarityLabel" style="-fx-font-size: 15px; -fx-text-fill: #704214;" text="Common" />
            <Label fx:id="habitatLabel" style="-fx-font-size: 12px; -fx-text-fill: #555555;" text="Habitat" />
            <Label fx:id="costLabel" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #31572C;" text="Cost" />
            <Label fx:id="balanceLabel" style="-fx-font-size: 12px; -fx-text-fill: #555555;" text="Balance" />
            <Label fx:id="messageLabel" prefHeight="60.0" style="-fx-font-size: 12px; -fx-text-fill: #333333;" text="" textAlignment="CENTER" wrapText="true" />
            <Button fx:id="buyButton" mnemonicParsing="false" onAction="#handleBuyButtonClick" prefHeight="34.0" prefWidth="200.0" style="-fx-background-color: #527A34; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10px;" text="BUY" />
            <Button fx:id="closeButton" mnemonicParsing="false" onAction="#handleCloseButtonClick" prefHeight="30.0" prefWidth="200.0" style="-fx-background-color: #8B5A2B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10px;" text="CANCEL" />
         </children>
      </VBox>
   </children>
</AnchorPane>
