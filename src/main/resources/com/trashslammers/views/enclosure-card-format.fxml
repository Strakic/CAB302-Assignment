<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="cardRoot" alignment="CENTER_LEFT" prefHeight="80.0" spacing="8.0" style="-fx-background-color: #333333; -fx-background-radius: 8px; -fx-border-color: #444444; -fx-border-radius: 8px;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.trashslammers.controller.EnclosureCardController">
    <padding>
        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
    </padding>
    <children>
        <VBox alignment="CENTER_LEFT" spacing="2.0" HBox.hgrow="ALWAYS">
            <children>
                <Label fx:id="titleLabel" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: white;" text="Enclosure Name" />
                <Label fx:id="statsLabel" style="-fx-font-size: 9px; -fx-text-fill: #aaaaaa;" text="Habitat: " />
                <Label fx:id="multiplierLabel" style="-fx-font-size: 9px; -fx-text-fill: #FFD700; -fx-font-weight: bold;" text="ScoreMult: 1.0x" />
            </children>
        </VBox>

        <Button fx:id="viewButton" minWidth="50.0" prefWidth="50.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 9px; -fx-padding: 4px 6px;" text="View" HBox.hgrow="NEVER" />

        <StackPane prefHeight="50.0" prefWidth="50.0" styleClass="bin, bin-recycle" HBox.hgrow="NEVER">
            <children>
                <ImageView fx:id="animalIcon" fitHeight="44.0" fitWidth="44.0" pickOnBounds="true" preserveRatio="true" />
            </children>
        </StackPane>
    </children>
</HBox>