<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="12.0" prefHeight="600.0" prefWidth="800.0"
      style="-fx-background-color: #A8D86E;"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.trashslammers.controller.EnclosureController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>

      <Label styleClass="title-label" text="TRASH SLAMMERS" />
      <Label styleClass="subtitle-label" text="KOALA HABITAT" />

      <HBox alignment="CENTER" spacing="40.0">
         <children>
            <Label style="-fx-font-size: 36px;" text="🌳" />

            <AnchorPane prefHeight="330.0" prefWidth="330.0" maxWidth="330.0" maxHeight="330.0"
                        style="-fx-background-color: #7DB957; -fx-border-color: #704214; -fx-border-width: 8px; -fx-border-radius: 5px; -fx-background-radius: 5px;">
               <children>
                  <Label layoutX="20.0" layoutY="45.0" style="-fx-font-size: 36px;" text="🌳" />
                  <Label layoutX="35.0" layoutY="130.0" style="-fx-font-size: 36px;" text="🪨" />

                  <AnchorPane layoutX="205.0" layoutY="155.0" prefHeight="55.0" prefWidth="90.0"
                              style="-fx-background-color: #6CB6D9; -fx-background-radius: 30px;">
                     <children>
                        <Label layoutX="38.0" layoutY="20.0" style="-fx-font-size: 36px;" text="🌊" />
                     </children>
                  </AnchorPane>

                  <VBox fx:id="koala1" alignment="CENTER" layoutX="85.0" layoutY="65.0"
                        onMouseClicked="#handleKoala1Click" prefHeight="70.0" prefWidth="80.0"
                        style="-fx-cursor: hand;">
                     <children>
                        <Label style="-fx-font-size: 40px;" text="🐨" />
                     </children>
                  </VBox>

                  <VBox fx:id="koala2" alignment="CENTER" layoutX="180.0" layoutY="90.0"
                        onMouseClicked="#handleKoala2Click" prefHeight="70.0" prefWidth="80.0"
                        style="-fx-cursor: hand;">
                     <children>
                        <Label style="-fx-font-size: 40px;" text="🐨" />
                     </children>
                  </VBox>
               </children>
            </AnchorPane>

            <Label style="-fx-font-size: 36px;" text="🌳" />
         </children>
      </HBox>

      <Label style="-fx-background-color: #8B5A2B; -fx-text-fill: white; -fx-padding: 8px 14px;" text="GATE" />

      <VBox spacing="4.0" maxWidth="480.0"
            style="-fx-background-color: #E5C07B; -fx-border-color: #704214; -fx-border-width: 3px;">
         <padding>
            <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
         </padding>
         <children>
            <Label styleClass="body-label" text="CURRENT RESIDENTS" />
            <HBox spacing="6.0">
               <children>
                  <Label onMouseClicked="#handleKoala1Click" style="-fx-text-fill: #1B4332; -fx-underline: true; -fx-cursor: hand;" text="Kai" />
                  <Label text="— Australian Koala ★★★☆☆" />
               </children>
            </HBox>
            <HBox spacing="6.0">
               <children>
                  <Label onMouseClicked="#handleKoala2Click" style="-fx-text-fill: #1B4332; -fx-underline: true; -fx-cursor: hand;" text="Willow" />
                  <Label text="— Australian Koala ★★★★☆" />
               </children>
            </HBox>
         </children>
      </VBox>

      <Button mnemonicParsing="false" onAction="#goBack" prefWidth="220.0" text="BACK TO GAME" />

   </children>
</VBox>