<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.trashslammers.controller.OptionsController">
   <children>
      <VBox styleClass="screen-sky" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>

            <HBox alignment="CENTER_LEFT">
               <children>
                  <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" text="BACK" />
               </children>
            </HBox>

            <VBox alignment="CENTER" spacing="30.0" VBox.vgrow="ALWAYS">
               <children>
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="title-label" text="OPTIONS" />

                  <CheckBox fx:id="premiumCheckbox" mnemonicParsing="false"
                            onAction="#handleActivatePremium" styleClass="subtitle-label"
                            text="Activate Premium" />

                  <Button fx:id="addAnimalButton" mnemonicParsing="false"
                          onAction="#handleAddAnimal" prefWidth="240.0" text="ADD ANIMAL" />
               </children>
            </VBox>

         </children>
      </VBox>

      <AnchorPane prefHeight="95.0" styleClass="screen-ground" />
   </children>
</VBox>