<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="480.0" prefWidth="420.0" style="-fx-background-color: #E5C07B;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.trashslammers.controller.AnimalPlaceController">
   <children>
      <VBox alignment="TOP_CENTER" layoutX="30.0" layoutY="25.0" prefHeight="430.0" prefWidth="360.0" spacing="16.0" style="-fx-background-color: white; -fx-border-color: #704214; -fx-border-width: 4px; -fx-padding: 16px; -fx-background-radius: 10px; -fx-border-radius: 10px;">
         <children>
            <Label fx:id="nameLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #31572C;" text="Name" />
            <Label fx:id="factLabel" prefHeight="60.0" style="-fx-font-size: 12px; -fx-text-fill: #333333;" text="Fact" textAlignment="CENTER" wrapText="true" />
            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #527A34;" text="CHOOSE AN ENCLOSURE" />
            <ComboBox fx:id="enclosureComboBox" prefWidth="260.0" />
            <Label fx:id="messageLabel" prefHeight="50.0" style="-fx-font-size: 12px; -fx-text-fill: #333333;" text="" textAlignment="CENTER" wrapText="true" />
            <Button fx:id="placeButton" mnemonicParsing="false" onAction="#handlePlaceButtonClick" prefHeight="34.0" prefWidth="200.0" style="-fx-background-color: #527A34; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10px;" text="PLACE IN ENCLOSURE" />
            <Button fx:id="closeButton" mnemonicParsing="false" onAction="#handleCloseButtonClick" prefHeight="30.0" prefWidth="200.0" style="-fx-background-color: #8B5A2B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10px;" text="CANCEL" />
         </children>
      </VBox>
   </children>
</AnchorPane>
