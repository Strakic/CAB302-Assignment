<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.trashslammers.controller.AnimalShopController">
    <center>
        <GridPane BorderPane.alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="70" />
                <ColumnConstraints hgrow="NEVER" percentWidth="30" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Button mnemonicParsing="false" maxWidth="-Infinity" text="Buy" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Button mnemonicParsing="false" maxWidth="-Infinity" text="Buy" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Button mnemonicParsing="false" maxWidth="-Infinity" text="Buy" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </children>
        </GridPane>
    </center>
</BorderPane>