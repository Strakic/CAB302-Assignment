<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.trashslammers.controller.AnimalShopController">
   <children>
      <VBox alignment="CENTER" spacing="10.0" styleClass="screen-sky" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
         </padding>
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="title-label" text="ANIMAL SHOP" />

            <Label fx:id="pointsLabel" styleClass="subtitle-label" text="Points: 0" />

            <HBox spacing="20.0" alignment="CENTER_LEFT">
               <children>
                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="body-label" text="Sort" />
                        <ComboBox fx:id="sortComboBox" prefWidth="200.0" />
                     </children>
                  </VBox>
                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="body-label" text="Show" />
                        <ComboBox fx:id="filterComboBox" prefWidth="180.0" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <ScrollPane fx:id="animalScrollPane" fitToWidth="true" hbarPolicy="NEVER"
                        styleClass="panel-scroll" VBox.vgrow="ALWAYS" maxWidth="Infinity">
               <content>
                  <TilePane fx:id="animalGrid" hgap="14.0" prefColumns="5"
                            prefTileHeight="200.0" prefTileWidth="175.0" vgap="14.0">
                     <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                     </padding>
                  </TilePane>
               </content>
            </ScrollPane>
         </children>
      </VBox>

      <AnchorPane prefHeight="95.0" styleClass="screen-ground">
         <children>
            <Button layoutX="267.0" layoutY="20.0" mnemonicParsing="false"
                    onAction="#handleCloseButtonClick" prefWidth="265.0" prefHeight="56.0"
                    text="BACK TO GAME" />
         </children>
      </AnchorPane>
   </children>
</VBox>