<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.trashslammers.controller.AnimalShopController">
   <children>
      <AnchorPane prefHeight="505.0" prefWidth="800.0" style="-fx-background-color: #a8dcf0;">
         <children>
            <Text layoutX="264.0" layoutY="52.0" strokeType="OUTSIDE" strokeWidth="0.0" text="ANIMAL SHOP">
               <font>
                  <Font name="PIXY" size="40.0" />
               </font>
            </Text>
            <Label fx:id="pointsLabel" alignment="CENTER" layoutX="300.0" layoutY="62.0" prefWidth="200.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #31572C;" text="Points: 0">
               <font>
                  <Font name="PIXY" size="18.0" />
               </font>
            </Label>
            <Label layoutX="30.0" layoutY="98.0" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #31572C;" text="Sort" />
            <ComboBox fx:id="sortComboBox" layoutX="30.0" layoutY="118.0" prefWidth="200.0" />
            <Label layoutX="250.0" layoutY="98.0" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #31572C;" text="Show" />
            <ComboBox fx:id="filterComboBox" layoutX="250.0" layoutY="118.0" prefWidth="180.0" />
            <ScrollPane fx:id="animalScrollPane" fitToWidth="true" hbarPolicy="NEVER" layoutX="20.0" layoutY="160.0" prefHeight="330.0" prefWidth="760.0" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: #704214; -fx-border-width: 3px;">
               <content>
                  <TilePane fx:id="animalGrid" hgap="14.0" prefColumns="4" prefTileHeight="200.0" prefTileWidth="175.0" style="-fx-padding: 14px;" vgap="14.0" />
               </content>
            </ScrollPane>
         </children>
      </AnchorPane>
      <AnchorPane prefHeight="95.0" prefWidth="800.0" style="-fx-background-color: #aed581;">
         <children>
            <Button layoutX="267.0" layoutY="20.0" mnemonicParsing="false" onAction="#handleCloseButtonClick" prefHeight="56.0" prefWidth="265.0" style="-fx-font-size: 18; -fx-background-radius: 30; -fx-font-weight: bold; -fx-text-fill: black; -fx-background-color: linear-gradient(to bottom, #ffd76b, #f5a623); -fx-border-color: #ffd76b; -fx-border-radius: 30; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 4, 0, 0, 2);" text="BACK TO GAME">
               <font>
                  <Font name="PIXY" size="18.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>
   </children>
