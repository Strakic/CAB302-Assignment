<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.trashslammers.controller.MainMenuController">
   <children>
      <VBox alignment="CENTER" spacing="20.0" styleClass="screen-sky" VBox.vgrow="ALWAYS">
         <children>
            <Text fx:id="titleText" styleClass="title-label" strokeType="OUTSIDE" strokeWidth="0.0" text="TRASH SLAMMERS" />

            <Text fx:id="messageText" styleClass="body-label" strokeType="OUTSIDE" strokeWidth="0.0" />

            <Region prefHeight="20.0" />

            <Button fx:id="playButton" onAction="#handlePlayButtonClick"
                    mnemonicParsing="false" prefWidth="320.0" prefHeight="70.0"
                    styleClass="button-large" text="PLAY" />

            <Button fx:id="loginButton" onAction="#handleLoginButtonClick"
                    mnemonicParsing="false" prefWidth="260.0" text="LOGIN" />

            <Button onAction="#handleOptionsButtonClick"
                    mnemonicParsing="false" prefWidth="260.0" text="OPTIONS" />

            <Button onAction="#handleExitButtonClick" mnemonicParsing="false" prefWidth="260.0" text="EXIT" />
         </children>
      </VBox>

      <AnchorPane prefHeight="95.0" styleClass="screen-ground" />
   </children>
</VBox>